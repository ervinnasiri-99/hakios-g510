# HakiOS fragment: the MediaTek MT6765 (Helio G35) -- what is true of the SoC, whatever device it is in.
# The processor has eight cores and the biggest is core 0; the temperature sensors, the chip-identity memory
# and the PMIC arbiter are at the addresses of this family.
CONFIG_SOC="mt6765"
CONFIG_CPUS=8
CONFIG_BOOTCPU=0
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_PMIC=y
# the drivers of this SoC family: a device with it gets them from here, whatever phone-specific drivers it leaves out
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
CONFIG_HAKIOS_MTK_CONNSYS=y
CONFIG_HAKIOS_MTK_EMMC=y
CONFIG_HAKIOS_MTK_KEYS=y