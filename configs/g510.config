# HakiOS fragment: the General Mobile GM 21 Plus (G510) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="g510"
CONFIG_FIRMWARE="device"
CONFIG_CPUS=8
CONFIG_BOOTCPU=0
CONFIG_CPUFREQ=y
CONFIG_EMMC=y
CONFIG_EMMC_ROOT=y
CONFIG_TOUCHSCREEN=y
CONFIG_BUTTONS=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_PMIC=y
CONFIG_HAKIOS_MTK_CPUFREQ=y
CONFIG_HAKIOS_MTK_EMMC=y
CONFIG_HAKIOS_MTK_KEYS=y
CONFIG_HAKIOS_MTK_TCM=y
CONFIG_HAKIOS_MTK_SCP=y
CONFIG_HAKIOS_MTK_CONNSYS=y
CONFIG_HAKIOS_MTK_WIFI=y
CONFIG_HAKIOS_MTK_BT=y
CONFIG_HAKIOS_MTK_AUDIO=y
CONFIG_HAKIOS_MTK_CAMERA=y
CONFIG_HAKIOS_MTK_TORCH=y
CONFIG_HAKIOS_MTK_PVRGPU=y
CONFIG_HAKIOS_MTK_BATTERY=y
CONFIG_HAKIOS_MTK_PMIC=y
CONFIG_HAKIOS_MTK_THERMAL=y
CONFIG_HAKIOS_MTK_SOCINFO=y