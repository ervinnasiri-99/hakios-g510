# HakiOS fragment: the General Mobile GM 21 Plus (G510, devices/g510) -- what is true of this phone and of no other with the same SoC.
# The vibration motor's variant (not present on this device), and where the modem's remote-file-system buffer is in its memory map.
CONFIG_DEVICE="g510"
CONFIG_HAKIOS_TCM=y
CONFIG_HAKIOS_MTK_KEYS=y
CONFIG_HAKIOS_MTK_CONNSYS=y
CONFIG_HAKIOS_MTK_EMMC=y
CONFIG_HAKIOS_MTK_SCP=y
CONFIG_HAKIOS_MTK_CPUFREQ=y
CONFIG_HAKIOS_MTK_BATT=y
CONFIG_HAKIOS_MTK_BT=y
CONFIG_HAKIOS_MTK_KEYS=y
# Panel: 720x1600, scale 2
CONFIG_FBSCALE=2
CONFIG_FBFIT=3
CONFIG_FB_QUEUE=1
CONFIG_FB_FLIP=y
CONFIG_FB_INUSE=y
CONFIG_SURF_ALIGN=y
CONFIG_SURF_LOCKWAIT=y
# Boot args: 8 cores, touchscreen on SPI0, buttons on keypad, cpufreq on
CONFIG_BOOTARGS="cpus=8 touchscreen=1 buttons=2 mtk_cpufreq=3 emmc_root=1 connsys_step=11 mtkbt_skel=1"