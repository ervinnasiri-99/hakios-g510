# HakiOS fragment: the MediaTek MT6765 (Helio P35/G35) SoC -- what is true of this chip and of all devices using it.
# The core configuration: 8 Cortex-A53 cores, the memory bus, the chip's identity.
CONFIG_SOC="mt6765"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_FIRMWARE="device"

# The SoC's devices that are common to all MT6765 phones: the PMIC wrapper, the SCP, the GPU.
CONFIG_HAKIOS_MTK_SCP=y
CONFIG_HAKIOS_MTK_PVRGPU=y

# Boot args for the SoC baseline
CONFIG_BOOTARGS="cpus=8 mtk_cpufreq=3"
